{
    "preset": "laravel",
    "rules": {
        "blank_line_before_statement": {
            "statements": [
                "break",
                "continue",
                "declare",
                "return",
                "throw",
                "try"
            ]
        },
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": [
                "class",
                "function",
                "const"
            ]
        },
        "no_unused_imports": true,
        "not_operator_with_successor_space": false,
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays"
            ]
        },
        "phpdoc_align": {
            "align": "left"
        },
        "array_syntax": {
            "syntax": "short"
        },
        "concat_space": {
            "spacing": "one"
        },
        "binary_operator_spaces": {
            "default": "single_space"
        }
    }
}
