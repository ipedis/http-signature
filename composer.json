{
    "name": "ipedis/http-signature",
    "description": "Library to generate http signature",
    "type": "library",
    "require": {
        "guzzlehttp/guzzle": "~7.0",
        "php": ">=8.2.0",
        "symfony/http-foundation": "^7.4.0",
        "symfony/psr-http-message-bridge": "^7.4.0",
        "nyholm/psr7": "^1.3",
        "nesbot/carbon": "^3.11"
    },
    "authors": [
        {
            "name": "dev",
            "email": "dev@ipedis.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Ipedis\\HttpSignature\\": "src/",
            "Ipedis\\Demo\\HttpSignature\\": "demo/"
        }
    },
    "require-dev": {
        "rector/rector": "^2.3",
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.19",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Ipedis\\HttpSignature\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse",
        "pint": "pint",
        "pint:check": "pint --test",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "qa": [
            "@pint:check",
            "@phpstan",
            "@rector:check",
            "@test"
        ]
    }
}
